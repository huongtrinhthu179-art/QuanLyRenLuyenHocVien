@page "/login"

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">
        <img src="images/Logo_hoc_vien_ANND.png" class="login-logo" />

        <h3>CỔNG THÔNG TIN HỌC VIÊN</h3>
        <p>Học viện An ninh Nhân dân</p>

        <EditForm Model="@model" OnValidSubmit="@LoginUser">
            <DataAnnotationsValidator />

            <InputText class="form-control mb-3"
                       @bind-Value="model.UserName"
                       placeholder="Tên đăng nhập" />

            <InputText class="form-control mb-3"
                       type="password"
                       @bind-Value="model.Password"
                       placeholder="Mật khẩu" />

            <button class="btn btn-success w-100">
                Đăng nhập
            </button>
        </EditForm>

        <p class="text-danger mt-3">@message</p>

        <div class="mt-3 text-center">
            <a href="/register">Tạo tài khoản mới</a>
        </div>
    </div>
</div>

@code {

    LoginModel model = new();

    string message = "";

    async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(
            model.UserName,
            model.Password,
            false,
            false);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/dshocvien", true);
        }
        else
        {
            message = "Sai tài khoản hoặc mật khẩu.";
        }
    }

    class LoginModel
    {
        [Required]
        public string UserName { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }

}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap');

    .login-container {
        min-height: 100vh;
        width: 100%;
        padding: 24px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 15% 15%, rgba(255,255,255,.10), transparent 30%), linear-gradient(135deg, #0b3d2b 0%, #126344 55%, #198754 100%);
        font-family: 'Be Vietnam Pro', 'Segoe UI', sans-serif;
    }

    .login-card {
        width: 100%;
        max-width: 500px;
        padding: 42px 46px;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 24px;
        background: rgba(255,255,255,.98);
        box-shadow: 0 24px 65px rgba(0,0,0,.22);
        text-align: center;
    }

    .login-logo {
        width: 100px;
        height: 100px;
        object-fit: contain;
        display: block;
        margin: 0 auto 18px;
    }

    .login-card h3 {
        color: #104a34;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.45;
        letter-spacing: .3px;
        margin: 0 0 8px;
    }

    .login-card > p {
        color: #63756b;
        font-size: 15px;
        margin: 0 0 28px;
    }

    .login-card .form-control {
        width: 100%;
        height: 50px;
        box-sizing: border-box;
        margin-bottom: 16px;
        padding: 12px 15px;
        border: 1px solid #d7e2db;
        border-radius: 9px;
        background: #fbfdfb;
        color: #24372c;
        font: inherit;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s;
    }

        .login-card .form-control:focus {
            outline: none;
            border-color: #198754;
            box-shadow: 0 0 0 4px rgba(25,135,84,.12);
        }

    .login-card .btn-success,
    .login-card button[type="submit"] {
        width: 100%;
        min-height: 49px;
        margin-top: 3px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #198754, #11653f);
        color: white;
        font-family: inherit;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
    }

        .login-card .btn-success:hover,
        .login-card button[type="submit"]:hover {
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(17,101,63,.22);
        }

    .login-card a {
        color: #1476c6;
        font-weight: 600;
        text-decoration: none;
    }

        .login-card a:hover {
            text-decoration: underline;
        }

    .login-card .text-danger {
        font-size: 14px;
    }

    @@media (max-width: 576px) {
        .login-container {
            padding: 16px;
        }

        .login-card {
            padding: 32px 22px;
            border-radius: 18px;
        }

            .login-card h3 {
                font-size: 23px;
            }
    }
</style>