@page "/register"

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

@inject UserManager<IdentityUser> UserManager
@inject NavigationManager Navigation

<div class="register-container">
    <div class="register-card">

        <img src="/images/logo-hvannd.png"
             class="register-logo"
             alt="Logo Học viện"
             onerror="this.style.display='none'" />

        <h3>ĐĂNG KÝ TÀI KHOẢN</h3>
        <p class="register-subtitle">Cổng thông tin học viên</p>

        <EditForm Model="@model" OnValidSubmit="@RegisterUser">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-group">
                <label>Tên đăng nhập</label>
                <InputText class="form-control"
                           @bind-Value="model.UserName"
                           placeholder="Nhập tên đăng nhập" />
                <ValidationMessage For="@(() => model.UserName)" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText class="form-control"
                           @bind-Value="model.Email"
                           placeholder="Nhập email"
                           type="email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                <InputText class="form-control"
                           @bind-Value="model.Password"
                           placeholder="Tối thiểu 6 ký tự"
                           type="password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <button type="submit"
                    class="register-button"
                    disabled="@isSubmitting">
                @(isSubmitting ? "Đang tạo tài khoản..." : "Đăng ký")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="register-message">@message</div>
        }

        <div class="register-footer">
            Đã có tài khoản?
            <a href="/login">Đăng nhập</a>
        </div>
    </div>
</div>

<style>
    .register-container {
        min-height: 100vh;
        width: 100%;
        background: linear-gradient(135deg, #0f4b33, #19794b);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px 16px;
        box-sizing: border-box;
    }

    .register-card {
        width: 100%;
        max-width: 536px;
        background: #fff;
        border-radius: 22px;
        padding: 36px 50px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, .2);
        text-align: center;
        box-sizing: border-box;
    }

    .register-logo {
        width: 76px;
        height: 76px;
        object-fit: contain;
        margin-bottom: 14px;
    }

    .register-card h3 {
        color: #172b23;
        font-size: 29px;
        font-weight: 500;
        line-height: 1.35;
        margin: 0 0 8px;
    }

    .register-subtitle {
        color: #34443b;
        font-size: 18px;
        margin-bottom: 26px;
    }

    .form-group {
        text-align: left;
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-size: 15px;
            color: #27352e;
        }

    .register-card .form-control {
        width: 100%;
        height: 48px;
        padding: 10px 14px;
        border: 1px solid #ced8d2;
        border-radius: 6px;
        font-size: 16px;
        box-sizing: border-box;
    }

        .register-card .form-control:focus {
            border-color: #198754;
            outline: none;
            box-shadow: 0 0 0 3px rgba(25, 135, 84, .12);
        }

    .register-button {
        width: 100%;
        height: 48px;
        margin-top: 4px;
        border: none;
        border-radius: 5px;
        background: #198754;
        color: white;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
    }

        .register-button:hover {
            background: #146c43;
        }

        .register-button:disabled {
            opacity: .7;
            cursor: wait;
        }

    .register-message {
        margin-top: 16px;
        color: #146c43;
        overflow-wrap: anywhere;
    }

    .validation-summary {
        color: #b02a37;
        text-align: left;
        font-size: 14px;
    }

    .form-group ::deep .validation-message {
        color: #b02a37;
        font-size: 13px;
        margin-top: 4px;
    }

    .register-footer {
        margin-top: 24px;
        font-size: 16px;
        color: #34443b;
    }

        .register-footer a {
            color: #0877cf;
            margin-left: 4px;
            text-decoration: underline;
        }

    @@media (max-width: 576px) {
        .register-card {
            padding: 30px 22px;
        }

            .register-card h3 {
                font-size: 24px;
            }
    }

    }</style>

@code {
    private RegisterModel model = new();
    private string message = "";
    private bool isSubmitting;

    private async Task RegisterUser()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        message = "";

        try
        {
            var user = new IdentityUser
            {
                UserName = model.UserName.Trim(),
                Email = model.Email.Trim()
            };

            var result = await UserManager.CreateAsync(
                user, model.Password);

            if (result.Succeeded)
            {
                var roleResult = await UserManager.AddToRoleAsync(
                    user, "HocVien");

                if (!roleResult.Succeeded)
                {
                    message = "Tài khoản đã được tạo, nhưng chưa gán được vai trò: "
                        + string.Join(" | ",
                            roleResult.Errors.Select(e => e.Description));
                    return;
                }

                message = "Đăng ký thành công! Bạn có thể đăng nhập.";
                model = new RegisterModel();
            }
            else
            {
                message = string.Join(" | ",
                    result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            message = "Không thể tạo tài khoản: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [MinLength(6, ErrorMessage = "Mật khẩu phải có ít nhất 6 ký tự.")]
        public string Password { get; set; } = "";
    }
}