@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using MyWebApp.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<IdentityUser> UserManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Trang chủ">
            <img class="brand-logo-image" src="images/Logo_Bộ_Công_an_VN.png" alt="Biểu trưng Công an nhân dân" />
            <span class="brand-divider"></span>
            <img class="brand-logo-image academy-logo" src="images/Logo_hoc_vien_ANND.png" alt="Logo Học viện An ninh nhân dân" />
            <span class="brand-text"><strong>HỌC VIỆN AN NINH NHÂN DÂN</strong><small>HỆ THỐNG QUẢN LÝ RÈN LUYỆN HỌC VIÊN</small></span>
        </a>
        <div class="topbar-right">
            <span class="system-status"><i></i> HỆ THỐNG QUẢN LÝ</span>
            <div class="profile-menu">
                <RadzenButton class="user-avatar"
                              Text="HV"
                              Title="Tài khoản"
                              Click="ToggleProfileMenu" />
                <div class="profile-menu-panel @(showProfileMenu ? "open" : "")"
                     aria-hidden="@(!showProfileMenu)">
                        <div class="profile-menu-heading">Thông tin cá nhân</div>
                        <div class="profile-info-list">
                            <div class="profile-info-row"><span>Tên</span><strong>@profileName</strong></div>
                            <div class="profile-info-row"><span>Ngày sinh</span><strong>@profileDateOfBirth</strong></div>
                            <div class="profile-info-row"><span>Giới tính</span><strong>@profileGender</strong></div>
                            <div class="profile-info-row profile-role-row"><span>Vai trò</span><RadzenBadge Text="@profileRole" BadgeStyle="BadgeStyle.Success" /></div>
                        </div>
                        <form method="post" action="/logout">
                            <AntiforgeryToken />
                            <RadzenButton class="profile-logout"
                                          ButtonType="ButtonType.Submit"
                                          Icon="logout"
                                          Text="Đăng xuất" />
                        </form>
                    </div>
            </div>
        </div>
    </header>
    <div class="page-layout">
        <aside class="sidebar">
            <div class="side-caption">MENU CHÍNH</div>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><span>⌂</span> Trang chủ</NavLink>
            <NavLink class="nav-item" href="/dshocvien"><span>♙</span> Quản lý học viên</NavLink>
            <div class="side-caption side-caption-second">QUẢN LÝ RÈN LUYỆN</div>
            <NavLink class="nav-item" href="/ky-danh-gia">
                <span>▦</span> Quản lý kỳ đánh giá
            </NavLink>
            <NavLink class="nav-item" href="/nhap-ket-qua"><span>✓</span> Nhập kết quả đánh giá</NavLink>
            <NavLink class="nav-item" href="/bao-cao-ket-qua"><span>▥</span> Báo cáo kết quả</NavLink>
            <div class="side-caption side-caption-second">HỖ TRỢ</div>
            <div class="sidebar-footer">HỌC VIỆN AN NINH NHÂN DÂN</div>
        </aside>
        <main class="main-content">
            <div class="breadcrumb"><a href="/">Trang chủ</a><span>/</span>@SectionName</div>
            @Body
        </main>
    </div>
</div>
<div id="blazor-error-ui">Đã xảy ra lỗi. <a href="" class="reload">Tải lại</a><a class="dismiss">×</a></div>
<style>
    .app-shell {
        min-height: 100vh;
        background: #f1f7f4;
        color: #1e3027;
        font: 14px "Segoe UI", Arial, sans-serif;
    }

        .app-shell * {
            box-sizing: border-box;
        }

        .app-shell a {
            text-decoration: none;
        }

        .app-shell .topbar {
            position: relative;
            z-index: 20;
            min-height: 100px;
            padding: 0 30px;
            background: linear-gradient(105deg,#064b35,#087447);
            border-bottom: 2px solid #d6b84a;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            color: white;
        }

        .app-shell .brand {
            display: flex;
            align-items: center;
            gap: 18px;
            color: white;
        }

        .app-shell .brand-logo-image {
            width: 72px;
            height: 72px;
            object-fit: contain;
        }

        .app-shell .brand-divider {
            display: inline-block;
            height: 58px;
            width: 1px;
            background: #ffffff65;
        }

        .app-shell .brand-text {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .app-shell .brand-text strong {
                font-size: 19px;
                color: white;
            }

            .app-shell .brand-text small {
                color: #f4d977;
                font-size: 10px;
                letter-spacing: .8px;
            }

        .app-shell .topbar-right {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .app-shell .system-status {
            color: #e6f4eb;
            font-size: 12px;
        }

            .app-shell .system-status i {
                display: inline-block;
                width: 7px;
                height: 7px;
                background: #21a564;
                border-radius: 50%;
                margin-right: 6px;
            }

        .app-shell .profile-menu {
            position: relative;
        }

        .app-shell .user-avatar.rz-button {
            width: 38px;
            height: 38px;
            min-width: 38px;
            padding: 0;
            border-radius: 50%;
            background: #f5dc79;
            color: #12553a;
            font-weight: 700;
            border: 0;
            box-shadow: none;
        }

        .app-shell .profile-menu-panel {
            display: none;
            position: absolute;
            top: 50px;
            right: 0;
            width: 290px;
            background: white;
            color: #1e3027;
            border: 1px solid #e0ebe4;
            border-radius: 12px;
            box-shadow: 0 8px 24px #0d412a33;
            padding: 16px;
        }

            .app-shell .profile-menu-panel.open {
                display: block;
            }

        .app-shell .profile-menu-heading {
            font-weight: 700;
            color: #123f32;
            margin-bottom: 10px;
        }

        .app-shell .profile-info-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 14px;
        }

        .app-shell .profile-info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 12px;
        }

            .app-shell .profile-info-row span {
                color: #7d8b83;
            }

            .app-shell .profile-info-row strong {
                color: #2b3d31;
                text-align: right;
            }

        .app-shell .profile-logout.rz-button {
            width: 100%;
            background: #08764a;
            color: white;
            border-radius: 8px;
            font-weight: 700;
        }

        .app-shell .page-layout {
            display: flex;
            min-height: calc(100vh - 100px);
        }

        .app-shell .sidebar {
            width: 255px;
            flex-shrink: 0;
            background: linear-gradient(180deg,#064333,#07392e);
            padding: 25px 16px 18px;
            display: flex;
            flex-direction: column;
        }

        .app-shell .side-caption {
            color: #a7c9b6;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.1px;
            padding: 0 12px;
            margin-bottom: 12px;
        }

        .app-shell .side-caption-second {
            margin-top: 28px;
        }

        .app-shell .nav-item {
            border-radius: 9px;
            padding: 13px;
            width: 100%;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #f0f7f2;
            margin: 3px 0;
            font-size: 13px;
        }

            .app-shell .nav-item span {
                width: 18px;
                text-align: center;
                font-size: 17px;
            }

            .app-shell .nav-item:hover {
                background: #175b43;
                color: #ffe58b;
            }

            .app-shell .nav-item.active {
                background: #d9eee3;
                color: #08613d;
                font-weight: 700;
                border-left: 4px solid #e5c54e;
            }

        .app-shell .sidebar-footer {
            margin-top: auto;
            color: #9dbca9;
            font-size: 10px;
            letter-spacing: 1px;
            padding: 23px 10px 0;
        }

        .app-shell .main-content {
            min-width: 0;
            flex: 1;
            padding: 22px 25px 28px;
        }

        .app-shell .breadcrumb {
            font-size: 12px;
            color: #507567;
            margin-bottom: 18px;
        }

            .app-shell .breadcrumb a {
                color: #507567;
            }

            .app-shell .breadcrumb span {
                padding: 0 9px;
                color: #bdc8c0;
            }

    #blazor-error-ui {
        background: #fffbd5;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0,0,0,.2);
        display: none;
        left: 0;
        padding: .6rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }

        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: .75rem;
            top: .5rem;
        }

    @@media (max-width: 800px) {
        .app-shell .page-layout {
            display: block;
        }

        .app-shell .sidebar {
            width: 100%;
        }

        .app-shell .topbar {
            padding: 12px 16px;
            flex-wrap: wrap;
        }
    }
</style>
@code {
    private bool showProfileMenu;
    private string profileName = "Đang tải...";
    private string profileDateOfBirth = "Chưa cập nhật";
    private string profileGender = "Chưa cập nhật";
    private string profileRole = "Chưa gán vai trò";

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authentication.User.Identity?.IsAuthenticated != true)
            return;

        var user = await UserManager.GetUserAsync(authentication.User);
        if (user is null)
            return;

        profileName = user.UserName ?? "Chưa cập nhật";
        var roles = await UserManager.GetRolesAsync(user);
        profileRole = roles.Count == 0
            ? "Chưa gán vai trò"
            : string.Join(", ", roles.Select(TranslateRole));

        await using var db = await DbFactory.CreateDbContextAsync();
        var profile = await db.UserProfiles.AsNoTracking()
            .SingleOrDefaultAsync(item => item.UserId == user.Id);
        if (profile is null)
            return;

        if (!string.IsNullOrWhiteSpace(profile.FullName))
            profileName = profile.FullName;
        if (profile.DateOfBirth.HasValue)
            profileDateOfBirth = profile.DateOfBirth.Value.ToString("dd/MM/yyyy");
        if (!string.IsNullOrWhiteSpace(profile.Gender))
            profileGender = profile.Gender;
    }

    private static string TranslateRole(string role) => role switch
    {
        "Admin" => "Quản trị viên",
        "CanBo" => "Cán bộ",
        "HocVien" => "Học viên",
        _ => role
    };

    private void ToggleProfileMenu() => showProfileMenu = !showProfileMenu;

    private string SectionName => new Uri(Navigation.Uri).AbsolutePath.Trim('/') switch
    {
        "" => "Tổng quan",
        "dshocvien" => "Quản lý học viên",
        "ky-danh-gia" => "Kỳ đánh giá",
        "nhap-ket-qua" => "Nhập kết quả",
        "bao-cao-ket-qua" => "Báo cáo kết quả",
        _ => "Hệ thống quản lý"
    };
}
