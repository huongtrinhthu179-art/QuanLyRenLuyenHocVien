@code {
    private sealed class BaoCaoDong
    {
        public string HoTen { get; set; } = "";
        public string Lop { get; set; } = "";
        public double TongDiem { get; set; }
        public double TongDiemToiDa { get; set; }
        public double Diem { get; set; }
        public string XepLoai { get; set; } = "";
    }

    private List<KyDanhGia> cacKy = new();
    private List<string> cacLop = new();
    private List<BaoCaoDong> baoCao = new();
    private int kyId;
    private string lopChon = "";
    private string xepLoaiChon = "";
    private int soChuaDanhGia;
    private string tenKyDangChon = "";
    private string CsvDataUri => "data:text/csv;charset=utf-8," + Uri.EscapeDataString("\uFEFF" + TaoCsv());

    private string thongBaoLoi = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            cacKy = await db.KyDanhGias.AsNoTracking().OrderByDescending(x => x.Id).ToListAsync();
            cacLop = await db.HocViens.AsNoTracking()
                .Select(x => x.Lop).Where(x => x != null && x != "")
                .Distinct().OrderBy(x => x).ToListAsync();
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi tải dữ liệu: " + ex.GetBaseException().Message;
        }
    }

    private async Task TaiBaoCao()
    {
        baoCao.Clear();
        soChuaDanhGia = 0;
        thongBaoLoi = "";
        var ky = cacKy.FirstOrDefault(x => x.Id == kyId);
        tenKyDangChon = ky?.TenKy ?? "";
        if (ky == null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var hocVienQuery = db.HocViens.AsNoTracking().AsQueryable();
            if (!string.IsNullOrWhiteSpace(lopChon)) hocVienQuery = hocVienQuery.Where(x => x.Lop == lopChon);
            var danhSachHocVien = await hocVienQuery.OrderBy(x => x.Lop).ThenBy(x => x.HoTen).ToListAsync();
            var ketQua = await db.Set<KetQuaTieuChi>().AsNoTracking().Where(x => x.KyDanhGiaId == kyId).ToListAsync();

            var nhomKetQua = ketQua.GroupBy(x => x.HocVienId)
                .ToDictionary(g => g.Key, g => new { Tong = g.Sum(x => x.DiemDat), ToiDa = g.Sum(x => x.DiemToiDa) });
            soChuaDanhGia = danhSachHocVien.Count(x => !nhomKetQua.ContainsKey(x.Id));

            foreach (var hv in danhSachHocVien)
            {
                if (!nhomKetQua.TryGetValue(hv.Id, out var diemDaCham)) continue;
                var tong = diemDaCham.Tong;
                var tongToiDa = diemDaCham.ToiDa;
                if (tongToiDa <= 0) continue;
                var diemChuaLamTron = tong / tongToiDa * 10.0;
                var diem10 = Math.Round(diemChuaLamTron, 1, MidpointRounding.AwayFromZero);
                var xepLoai = XepLoai(diemChuaLamTron);
                if (!string.IsNullOrWhiteSpace(xepLoaiChon) && xepLoai != xepLoaiChon) continue;
                baoCao.Add(new BaoCaoDong { HoTen = hv.HoTen ?? "", Lop = hv.Lop ?? "", TongDiem = tong, TongDiemToiDa = tongToiDa, Diem = diem10, XepLoai = xepLoai });
            }
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi tải báo cáo: " + ex.GetBaseException().Message;
        }
    }

    private static string XepLoai(double diem) => diem switch { >= 9.0 => "Xuất sắc", >= 8.0 => "Giỏi", >= 7.0 => "Khá", >= 5.0 => "Trung bình", _ => "Không xếp loại" };
    private static string BadgeClass(string loai) => loai switch { "Xuất sắc" => "rating-excellent", "Giỏi" => "rating-good", "Khá" => "rating-fair", "Trung bình" => "rating-average", _ => "rating-none" };

    private string TaoCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("STT,Họ và tên,Lớp,Tổng điểm,Tổng điểm tối đa,Điểm/10,Xếp loại,Kỳ đánh giá");
        for (int i = 0; i < baoCao.Count; i++)
        {
            var x = baoCao[i];
            sb.Append(i + 1).Append(',').Append(Csv(x.HoTen)).Append(',').Append(Csv(x.Lop)).Append(',')
               .Append(x.TongDiem.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(',')
              .Append(x.TongDiemToiDa.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(',')
              .Append(x.Diem.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)).Append(',')
              .Append(Csv(x.XepLoai)).Append(',').Append(Csv(tenKyDangChon)).AppendLine();
        }
        return sb.ToString();
    }

    private static string Csv(string value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";
}
