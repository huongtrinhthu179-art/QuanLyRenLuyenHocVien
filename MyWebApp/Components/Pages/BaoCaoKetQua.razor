@code {
    private sealed class BaoCaoDong
    {
        public string HoTen { get; set; } = "";
        public string Lop { get; set; } = "";
        public Dictionary<int, double> ChiTiet { get; set; } = new();
        public double Diem { get; set; }
        public string XepLoai { get; set; } = "";
    }

    private List<KyDanhGia> cacKy = new();
    private List<TieuChiDanhGia> tieuChis = new();
    private List<string> cacLop = new();
    private List<string> cacXepLoai = new() { "Xuất sắc", "Giỏi", "Khá", "Trung bình", "Không xếp loại" };
    private List<BaoCaoDong> baoCao = new();
    private sealed class BoLocDaLuu
    {
        public int KyId { get; set; }
        public string? Lop { get; set; }
        public string? XepLoai { get; set; }
    }
    private int kyId;
    private string? lopChon = null;
    private string? xepLoaiChon = null;
    private int soChuaDanhGia;
    private string tenKyDangChon = "";
    private string CsvDataUri => "data:text/csv;charset=utf-8," + Uri.EscapeDataString("\uFEFF" + TaoCsv());

    private string thongBaoLoi = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await TieuChiCoDinh.DamBaoAsync(db);
            cacKy = await db.KyDanhGias.AsNoTracking().OrderByDescending(x => x.Id).ToListAsync();
            tieuChis = await db.TieuChiDanhGias.AsNoTracking()
                .Where(x => x.DangSuDung).OrderBy(x => x.ThuTu).ToListAsync();
            cacLop = await db.HocViens.AsNoTracking()
                .Select(x => x.Lop).Where(x => x != null && x != "")
                .Distinct().OrderBy(x => x).ToListAsync();
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi tải dữ liệu: " + ex.GetBaseException().Message;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var daLuu = await Luu.GetAsync<BoLocDaLuu>("bao-cao-bo-loc");

            if (daLuu.Success && daLuu.Value is not null && cacKy.Any(x => x.Id == daLuu.Value.KyId))
            {
                kyId = daLuu.Value.KyId;
                lopChon = daLuu.Value.Lop;
                xepLoaiChon = daLuu.Value.XepLoai;
            }
            else if (cacKy.Count > 0)
            {
                kyId = cacKy[0].Id;   // chưa có gì được lưu thì chọn kỳ mới nhất
            }

            if (kyId > 0) await TaiBaoCao();
        }
        catch
        {
            // bỏ qua, người dùng vẫn chọn tay được
        }

        StateHasChanged();
    }
    private async Task TaiBaoCao()
    {
        baoCao.Clear();
        soChuaDanhGia = 0;
        thongBaoLoi = "";
        var ky = cacKy.FirstOrDefault(x => x.Id == kyId);
        tenKyDangChon = ky?.TenKy ?? "";
        if (ky == null) return;
        try
        {
            await Luu.SetAsync("bao-cao-bo-loc", new BoLocDaLuu
            {
                KyId = kyId,
                Lop = lopChon,
                XepLoai = xepLoaiChon
            });
        }
        catch { }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var hocVienQuery = db.HocViens.AsNoTracking().AsQueryable();
            if (!string.IsNullOrWhiteSpace(lopChon)) hocVienQuery = hocVienQuery.Where(x => x.Lop == lopChon);
            var danhSachHocVien = await hocVienQuery.OrderBy(x => x.Lop).ThenBy(x => x.HoTen).ToListAsync();

            // Chỉ lấy điểm của 5 tiêu chí đang dùng
            var idTieuChi = tieuChis.Select(x => x.Id).ToList();
            var ketQua = await db.Set<KetQuaTieuChi>().AsNoTracking()
                .Where(x => x.KyDanhGiaId == kyId && idTieuChi.Contains(x.TieuChiDanhGiaId))
                .ToListAsync();

            var nhomKetQua = ketQua.GroupBy(x => x.HocVienId).ToDictionary(g => g.Key, g => g.ToList());
            soChuaDanhGia = danhSachHocVien.Count(x => !nhomKetQua.ContainsKey(x.Id));

            var tongToiDa = tieuChis.Sum(x => x.DiemToiDa);
            if (tongToiDa <= 0) return;

            foreach (var hv in danhSachHocVien)
            {
                if (!nhomKetQua.TryGetValue(hv.Id, out var cacDong)) continue;

                var tong = cacDong.Sum(x => x.DiemDat);
                var diemChuaLamTron = tong / tongToiDa * 10.0;
                var diem10 = Math.Round(diemChuaLamTron, 1, MidpointRounding.AwayFromZero);
                var xepLoai = XepLoai(diemChuaLamTron);
                if (!string.IsNullOrWhiteSpace(xepLoaiChon) && xepLoai != xepLoaiChon) continue;

                baoCao.Add(new BaoCaoDong
                {
                    HoTen = hv.HoTen ?? "",
                    Lop = hv.Lop ?? "",
                    ChiTiet = cacDong.GroupBy(x => x.TieuChiDanhGiaId)
                                     .ToDictionary(g => g.Key, g => g.Sum(v => v.DiemDat)),
                    Diem = diem10,
                    XepLoai = xepLoai
                });
            }
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi tải báo cáo: " + ex.GetBaseException().Message;
        }
    }

    private static string XepLoai(double diem) => diem switch { >= 9.0 => "Xuất sắc", >= 8.0 => "Giỏi", >= 7.0 => "Khá", >= 5.0 => "Trung bình", _ => "Không xếp loại" };
    private static string BadgeClass(string loai) => loai switch { "Xuất sắc" => "rating-excellent", "Giỏi" => "rating-good", "Khá" => "rating-fair", "Trung bình" => "rating-average", _ => "rating-none" };

    private string TaoCsv()
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();

        sb.Append("STT,Họ và tên,Lớp");
        foreach (var tc in tieuChis)
            sb.Append(',').Append(Csv($"{tc.ThuTu}. {tc.TenTieuChi} (tối đa {tc.DiemToiDa.ToString("0.##", inv)})"));
        sb.AppendLine(",Tổng điểm /10,Xếp loại,Kỳ đánh giá");

        for (int i = 0; i < baoCao.Count; i++)
        {
            var x = baoCao[i];
            sb.Append(i + 1).Append(',').Append(Csv(x.HoTen)).Append(',').Append(Csv(x.Lop));
            foreach (var tc in tieuChis)
                sb.Append(',').Append(x.ChiTiet.GetValueOrDefault(tc.Id).ToString("0.##", inv));
            sb.Append(',').Append(x.Diem.ToString("0.0", inv))
              .Append(',').Append(Csv(x.XepLoai))
              .Append(',').Append(Csv(tenKyDangChon)).AppendLine();
        }
        return sb.ToString();
    }

    private static string Csv(string value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";
}