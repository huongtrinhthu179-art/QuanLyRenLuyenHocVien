@page "/bao-cao-ket-qua"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MyWebApp.Models
@inject IDbContextFactory<MyWebApp.Data.AppDbContext> DbFactory

<PageTitle>Báo cáo kết quả rèn luyện</PageTitle>

<div class="page-content">
<div class="section-heading page-title-row">
                <div><span class="eyebrow green-text">THỐNG KÊ VÀ TỔNG HỢP</span><h1>Báo cáo kết quả rèn luyện</h1><p>Xem kết quả theo kỳ đánh giá, lọc theo lớp và xuất báo cáo CSV.</p></div>
                <a class="btn-outline" href="/nhap-ket-qua">＋ Nhập kết quả</a>
            </div>
            @if (!string.IsNullOrEmpty(thongBaoLoi))
            {
                <div style="background:#fff0ef;color:#a83e37;padding:12px 15px;border-radius:9px;margin-bottom:18px;font-size:12px">@thongBaoLoi</div>
            }
            <section class="panel filter-panel">
                <div class="form-grid">
                    <div class="form-field">
                        <label>Kỳ đánh giá</label>
                        <select class="form-control-custom" @bind="kyId" @bind:after="TaiBaoCao">
                            <option value="0">-- Chọn kỳ đánh giá --</option>
                            @foreach (var ky in cacKy)
                            {
                                <option value="@ky.Id">@ky.TenKy</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Lớp học viên</label>
                        <select class="form-control-custom" @bind="lopChon" @bind:after="TaiBaoCao">
                            <option value="">Tất cả các lớp</option>
                            @foreach (var lop in cacLop)
                            {
                                <option value="@lop">@lop</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Xếp loại</label>
                        <select class="form-control-custom" @bind="xepLoaiChon" @bind:after="TaiBaoCao">
                            <option value="">Tất cả xếp loại</option>
                            <option>Xuất sắc</option>
                            <option>Giỏi</option>
                            <option>Khá</option>
                            <option>Trung bình</option>
                            <option>Không xếp loại</option>
                        </select>
                    </div>
                </div>
            </section>

            @if (kyId > 0)
            {
                <div class="stats-grid">
                    <div class="stat-card"><div class="stat-icon green-icon">♙</div><div class="stat-label">Học viên đã đánh giá</div><div class="stat-number">@baoCao.Count</div><div class="stat-foot">Trong điều kiện lọc hiện tại</div></div>
                    <div class="stat-card"><div class="stat-icon blue-icon">◎</div><div class="stat-label">Điểm trung bình</div><div class="stat-number">@(baoCao.Count == 0 ? "0.0" : baoCao.Average(x => x.Diem).ToString("0.0"))</div><div class="stat-foot">Thang điểm 10</div></div>
                    <div class="stat-card"><div class="stat-icon gold-icon">★</div><div class="stat-label">Xếp loại Xuất sắc</div><div class="stat-number">@baoCao.Count(x => x.XepLoai == "Xuất sắc")</div><div class="stat-foot">Học viên đạt từ 9.0 điểm</div></div>
                    <div class="stat-card"><div class="stat-icon purple-icon">✓</div><div class="stat-label">Chưa có kết quả</div><div class="stat-number">@soChuaDanhGia</div><div class="stat-foot">Học viên chưa được nhập điểm</div></div>
                </div>

                <section class="panel">
                    <div class="panel-heading">
                        <div><h2>Danh sách kết quả</h2><p>Kỳ: <b>@tenKyDangChon</b> · Hiển thị @baoCao.Count học viên đã có điểm.</p></div>
                        @if (baoCao.Count > 0)
                        {
                            <a class="btn-primary" href="@CsvDataUri" download="BaoCaoKetQuaRenLuyen.csv">↓ Xuất CSV</a>
                        }
                    </div>
                    @if (baoCao.Count == 0)
                    {
                        <div class="empty-state"><div>▤</div><b>Chưa có kết quả phù hợp</b><p>Chọn kỳ khác hoặc nhập điểm tại trang Nhập kết quả.</p></div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>STT</th><th>HỌ VÀ TÊN</th><th>LỚP</th><th>TỔNG ĐIỂM</th><th>ĐIỂM / 10</th><th>XẾP LOẠI</th></tr></thead>
                                <tbody>
                                    @for (int i = 0; i < baoCao.Count; i++)
                                    {
                                        var item = baoCao[i];
                                        <tr><td>@(i + 1)</td><td><b>@item.HoTen</b></td><td><span class="class-tag">@item.Lop</span></td><td>@item.TongDiem.ToString("0.##") / @item.TongDiemToiDa.ToString("0.##")</td><td><b class="score-value">@item.Diem.ToString("0.0")</b><span class="muted-cell"> / 10</span></td><td><span class="rating-badge @BadgeClass(item.XepLoai)">@item.XepLoai</span></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="panel empty-state"><div>▤</div><b>Chọn kỳ đánh giá để xem báo cáo</b><p>Bạn có thể lọc thêm theo lớp và xếp loại sau khi chọn kỳ.</p></section>
            }
            <footer class="page-footer"><span>QUẢN LÝ RÈN LUYỆN HỌC VIÊN</span><span>Hệ thống quản lý nội bộ · Phiên bản 1.0</span></footer>
        </div>

<style>
