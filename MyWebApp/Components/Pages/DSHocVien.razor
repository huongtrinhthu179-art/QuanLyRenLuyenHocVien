@code {
    protected override async Task OnInitializedAsync()
    {
        hocViens = await DbContext.HocViens
            .AsNoTracking()
            .OrderBy(x => x.Id)
            .ToListAsync();
    }
    private List<HocVien> hocViens = new();
    private HocVien hocVien = new();
    private int? editingId;
    private int nextId = 1;

    private bool showDashboard = true;
    private bool showForm;
    private string searchText = "";
    private string filterClass = "";
    private string filterRating = "";
    private string message = "";

    private string CurrentSection => showDashboard ? "Tổng quan" : "Quản lý học viên";

    private double AverageScore => hocViens.Count == 0
    ? 0
    : hocViens.Average(x => x.DiemRenLuyen);

    private List<HocVien> FilteredStudents => hocViens
    .Where(x =>
    {
        var keyword = searchText.Trim();

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            bool matchText =
                (x.HoTen ?? "").Contains(keyword,
                    StringComparison.OrdinalIgnoreCase)
                || (x.Lop ?? "").Contains(keyword,
                    StringComparison.OrdinalIgnoreCase)
                || (x.DiaChiHienTai ?? "").Contains(keyword,
                    StringComparison.OrdinalIgnoreCase);

            bool matchDate =
                x.NgaySinh.ToString("dd/MM/yyyy").Contains(keyword)
                || x.NgaySinh.ToString("MM/yyyy").Contains(keyword)
                || x.NgaySinh.ToString("MM").Contains(keyword)
                || x.NgaySinh.ToString("yyyy").Contains(keyword);

            bool matchScore =
                x.DiemRenLuyen.ToString().Contains(keyword)
                || x.DiemRenLuyen.ToString("0.0").Contains(keyword);

            if (!matchText && !matchDate && !matchScore)
                return false;
        }

        bool matchClass =
            string.IsNullOrWhiteSpace(filterClass)
            || string.Equals(x.Lop, filterClass,
                StringComparison.OrdinalIgnoreCase);

        bool matchRating =
            string.IsNullOrWhiteSpace(filterRating)
            || x.XepLoai == filterRating;

        return matchClass && matchRating;
    })
    .OrderBy(x => x.HoTen)
    .ToList();

    private string NavClass(bool students) =>
        "nav-item " + ((!showDashboard && students) || (showDashboard && !students) ? "active" : "");

    private void ShowDashboard()
    {
        showDashboard = true;
        showForm = false;
        message = "";
    }

    private void ShowStudents()
    {
        showDashboard = false;
        message = "";
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void NewStudent()
    {
        hocVien = new HocVien();
        editingId = null;
        showForm = true;
        message = "";
    }

    private void EditStudent(HocVien hv)
    {
        hocVien = new HocVien
        {
            Id = hv.Id,
            HoTen = hv.HoTen,
            NgaySinh = hv.NgaySinh,
            Lop = hv.Lop,
            DiaChiHienTai = hv.DiaChiHienTai,
            DiemRenLuyen = hv.DiemRenLuyen
        };

        editingId = hv.Id;
        showForm = true;
        message = "";
    }

    private async Task SaveStudent()
    {
        if (string.IsNullOrWhiteSpace(hocVien.HoTen))
        {
            message = "Vui lòng nhập họ và tên học viên.";
            return;
        }

        if (hocVien.NgaySinh == default || hocVien.NgaySinh.Date > DateTime.Today)
        {
            message = "Vui lòng nhập ngày sinh hợp lệ.";
            return;
        }

        if (string.IsNullOrWhiteSpace(hocVien.Lop))
        {
            message = "Vui lòng nhập lớp của học viên.";
            return;
        }

        if (hocVien.DiemRenLuyen < 0 || hocVien.DiemRenLuyen > 10)
        {
            message = "Điểm rèn luyện phải nằm trong khoảng từ 0 đến 10.";
            return;
        }

        if (editingId.HasValue)
        {
            var existing = await DbContext.HocViens.FindAsync(editingId.Value);

            if (existing is null)
            {
                message = "Không tìm thấy học viên cần sửa.";
                return;
            }

            existing.HoTen = hocVien.HoTen.Trim();
            existing.NgaySinh = hocVien.NgaySinh;
            existing.Lop = hocVien.Lop.Trim();
            existing.DiaChiHienTai = hocVien.DiaChiHienTai?.Trim() ?? "";
            existing.DiemRenLuyen = hocVien.DiemRenLuyen;
        }
        else
        {
            DbContext.HocViens.Add(new HocVien
            {
                HoTen = hocVien.HoTen.Trim(),
                NgaySinh = hocVien.NgaySinh,
                Lop = hocVien.Lop.Trim(),
                DiaChiHienTai = hocVien.DiaChiHienTai?.Trim() ?? "",
                DiemRenLuyen = hocVien.DiemRenLuyen
            });
        }

        await DbContext.SaveChangesAsync();

        hocViens = await DbContext.HocViens
            .AsNoTracking()
            .OrderBy(x => x.Id)
            .ToListAsync();

        showForm = false;
        editingId = null;
        hocVien = new HocVien();
        message = "";
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        hocVien = new HocVien();
        message = "";
    }

    private async Task DeleteStudent(int id)
    {
        var hv = await DbContext.HocViens.FindAsync(id);

        if (hv is not null)
        {
            DbContext.HocViens.Remove(hv);
            await DbContext.SaveChangesAsync();

            hocViens = await DbContext.HocViens
                .AsNoTracking()
                .OrderBy(x => x.Id)
                .ToListAsync();
        }
    }

    private void ClearFilters()
    {
        searchText = "";
        filterClass = "";
        filterRating = "";
    }

    private string BadgeClass(string rating) => rating switch
    {
        "Xuất sắc" => "status-badge badge-tot",
        "Giỏi" => "status-badge badge-tot",
        "Khá" => "status-badge badge-kha",
        "Trung bình" => "status-badge badge-trungbinh",
        "Không xếp loại" => "status-badge badge-yeu",
        _ => "status-badge badge-yeu"
    };

    private string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "HV";

        var words = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 1
            ? words[0][..1].ToUpper()
            : (words[0][..1] + words[^1][..1]).ToUpper();
    }
}