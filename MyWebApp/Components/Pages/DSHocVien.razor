@page "/dshocvien"
@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using Microsoft.EntityFrameworkCore
@using MyWebApp.Models
@inject MyWebApp.Data.AppDbContext DbContext
@inject NavigationManager Navigation
<PageTitle>Quản lý rèn luyện học viên</PageTitle>

<div class="app-page">
    <header class="topbar">
        <div class="brand">
            <img class="brand-logo-image"
                 src="images/Logo_Bộ_Công_an_VN.png"
                 alt="Biểu trưng Công an nhân dân" />

            <div class="brand-divider"></div>

            <img class="brand-logo-image academy-logo"
                 src="images/Logo_hoc_vien_ANND.png"
                 alt="Logo Học viện An ninh nhân dân" />

            <div class="brand-text">
                <h2>HỌC VIỆN AN NINH NHÂN DÂN</h2>

                <small>HỆ THỐNG QUẢN LÝ RÈN LUYỆN HỌC VIÊN</small>
            </div>
        </div>

        <div class="topbar-right">
            <span class="system-status">
                <span></span> HỆ THỐNG QUẢN LÝ
            </span>
            <div class="user-avatar">HV</div>
        </div>
    </header>

    <div class="page-layout">
        <aside class="sidebar">
            <div class="side-caption">MENU CHÍNH</div>

            <button class="@NavClass(false)" @onclick="ShowDashboard">
                <span>⌂</span> Trang chủ
            </button>

            <button class="@NavClass(true)" @onclick="ShowStudents">
                <span>♙</span> Quản lý học viên
            </button>

            <div class="side-caption side-caption-second">
                QUẢN LÝ RÈN LUYỆN
            </div>

            <button class="nav-item" @onclick='() => NavigateTo("/ky-danh-gia")'>
                <span>▦</span> Quản lý kỳ đánh giá
            </button>

            <button class="nav-item" @onclick='() => NavigateTo("/quan-ly-tieu-chi")'>
                <span>☷</span> Quản lý tiêu chí
            </button>

            <button class="nav-item" @onclick='() => NavigateTo("/nhap-ket-qua")'>
                <span>✓</span> Nhập kết quả đánh giá
            </button>

            <button class="nav-item" @onclick='() => NavigateTo("/bao-cao-ket-qua")'>
                <span>▥</span> Báo cáo kết quả
            </button>

            <div class="side-caption side-caption-second">
                HỖ TRỢ
            </div>

            <button class="nav-item" @onclick="ShowDashboard">
                <span>?</span> Trợ giúp
            </button>

            <button class="nav-item logout-item" @onclick="ShowDashboard">
                <span>↪</span> Đăng xuất
            </button>

            <div class="sidebar-footer">
                HỌC VIỆN AN NINH NHÂN DÂN
            </div>
        </aside>

        <main class="main-content">
            <div class="breadcrumb">Trang chủ <span>/</span> @CurrentSection</div>

            @if (showDashboard)
            {
                <section class="welcome-banner">
                    <div>
                        <span class="eyebrow">CHÀO MỪNG BẠN ĐẾN VỚI</span>
                        <h1>Hệ thống quản lý rèn luyện học viên</h1>
                        <p>Đồng hành cùng học viên trong quá trình rèn luyện, học tập<br /> và xây dựng phẩm chất, bản lĩnh người chiến sĩ Công an nhân dân.</p>
                        <button class="btn-primary" @onclick="ShowStudents">
                            Quản lý học viên <span>→</span>
                        </button>
                    </div>
                    <div class="banner-symbol">
                    </div>
                </section>

                <div class="section-heading">
                    <div>
                        <h2>Tổng quan hệ thống</h2>
                        <p>Các số liệu được cập nhật từ danh sách hiện tại.</p>
                    </div>
                    <span class="live-tag">● ĐANG HOẠT ĐỘNG</span>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon green-icon">♙</div>
                        <div class="stat-label">Tổng học viên</div>
                        <div class="stat-number">@hocViens.Count</div>
                        <div class="stat-foot">Học viên trong danh sách</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon blue-icon">▤</div>
                        <div class="stat-label">Số lớp</div>
                        <div class="stat-number">@hocViens.Select(x => x.Lop).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div>
                        <div class="stat-foot">Lớp học có học viên</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon gold-icon">★</div>
                        <div class="stat-label">Xếp loại Xuất sắc</div>
                        <div class="stat-number">@hocViens.Count(x => x.XepLoai == "Xuất sắc")</div>
                        <div class="stat-foot">Xếp loại Xuất sắc</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple-icon">◎</div>
                        <div class="stat-label">Điểm trung bình</div>
                        <div class="stat-number">@AverageScore.ToString("0.0")</div>
                        <div class="stat-foot">Thang điểm 10</div>
                    </div>
                </div>

                <section class="panel">
                    <div class="panel-heading">
                        <div>
                            <h2>Học viên mới cập nhật</h2>
                            <p>Danh sách học viên hiện có trong hệ thống.</p>
                        </div>
                        <button class="btn-outline" @onclick="ShowStudents">Xem tất cả →</button>
                    </div>
                    @if (hocViens.Count == 0)
                    {
                        <div class="empty-state">
                            <div>▤</div>
                            <b>Chưa có dữ liệu học viên</b>
                            <p>Hãy thêm học viên để bắt đầu quản lý.</p>
                            <button class="btn-primary" @onclick="ShowStudents">+ Thêm học viên</button>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>HỌ VÀ TÊN</th>
                                        <th>LỚP</th>
                                        <th>ĐIỂM RÈN LUYỆN</th>
                                        <th>XẾP LOẠI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hv in hocViens.TakeLast(5).Reverse())
                                    {
                                        <tr>
                                            <td><b>@hv.HoTen</b></td>
                                            <td>@hv.Lop</td>
                                            <td>@hv.DiemRenLuyen.ToString("0.0") / 10</td>
                                            <td><span class="@BadgeClass(hv.XepLoai)">@hv.XepLoai</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
            else
            {
                <div class="section-heading page-title-row">
                    <div>
                        <span class="eyebrow green-text">QUẢN LÝ DỮ LIỆU</span>
                        <h1>Danh sách học viên</h1>
                        <p>Quản lý hồ sơ và theo dõi kết quả rèn luyện của từng học viên.</p>
                    </div>
                    <button class="btn-primary" @onclick="NewStudent">＋ Thêm học viên</button>
                </div>

                <div class="stats-grid compact-stats">
                    <div class="stat-card">
                        <div class="stat-label">Tổng học viên</div>
                        <div class="stat-number">@hocViens.Count</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Xếp loại Xuất sắc</div>
                        <div class="stat-number green-text">@hocViens.Count(x => x.XepLoai == "Xuất sắc")</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Xếp loại Khá</div>
                        <div class="stat-number">@hocViens.Count(x => x.XepLoai == "Khá")</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Trung bình / Không xếp loại</div>
                        <div class="stat-number">@hocViens.Count(x => x.XepLoai == "Trung bình" || x.XepLoai == "Không xếp loại")</div>
                    </div>
                </div>

                @if (showForm)
                {
                    <section class="panel form-panel">
                        <div class="panel-heading">
                            <div>
                                <h2>@(editingId.HasValue ? "Cập nhật hồ sơ học viên" : "Thêm học viên mới")</h2>
                                <p>Nhập đầy đủ thông tin vào các trường bên dưới.</p>
                            </div>
                            <button class="btn-close" @onclick="CancelForm">✕</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(message))
                        {
                            <div class="message-box">@message</div>
                        }

                        <div class="form-grid">
                            <div class="form-field full-field">
                                <label>Họ và tên <span>*</span></label>
                                <input @bind="hocVien.HoTen" placeholder="Nhập họ và tên học viên" />
                            </div>
                            <div class="form-field">
                                <label>Ngày sinh <span>*</span></label>
                                <input type="date" @bind="hocVien.NgaySinh" />
                            </div>
                            <div class="form-field">
                                <label>Lớp <span>*</span></label>
                                <input @bind="hocVien.Lop" placeholder="Ví dụ: D45A" />
                            </div>
                            <div class="form-field full-field">
                                <label>Địa chỉ hiện nay</label>
                                <input @bind="hocVien.DiaChiHienTai" placeholder="Nhập địa chỉ hiện nay" />
                            </div>
                            <div class="form-field">
                                <label>Điểm rèn luyện (0–10)</label>
                                <input type="number" min="0" max="10" step="0,1" @bind="hocVien.DiemRenLuyen" />
                            </div>
                            <div class="form-field">
                                <label>Xếp loại</label>
                                <div class="readonly-field">@hocVien.XepLoai</div>
                                <small>Tự động xác định theo điểm rèn luyện.</small>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button class="btn-secondary" @onclick="CancelForm">Hủy</button>
                            <button class="btn-primary" @onclick="SaveStudent">✓ @(editingId.HasValue ? "Lưu thay đổi" : "Lưu học viên")</button>
                        </div>
                    </section>
                }

                <section class="panel">
                    <div class="panel-heading">
                        <div>
                            <h2>Danh sách hồ sơ</h2>
                            <p>Hiển thị @FilteredStudents.Count trên tổng số @hocViens.Count học viên.</p>
                        </div>
                    </div>

                    <div class="filter-bar">
                        <div class="search-box">
                            <span>⌕</span>
                            <input @bind="searchText"
                                   @bind:event="oninput"
                                   placeholder="Tìm tên, lớp, ngày sinh, tháng, năm, điểm..." />
                        </div>
                        <select @bind="filterClass">
                            <option value="">Tất cả các lớp</option>
                            @foreach (var lop in hocViens.Select(x => x.Lop).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x))
                            {
                                <option value="@lop">@lop</option>
                            }
                        </select>
                        <select @bind="filterRating">
                            <option value="">Tất cả xếp loại</option>
                            <option value="Xuất sắc">Xuất sắc</option>
                            <option value="Giỏi">Giỏi</option>
                            <option value="Khá">Khá</option>
                            <option value="Trung bình">Trung bình</option>
                            <option value="Không xếp loại">Không xếp loại</option>
                        </select>
                        <button class="btn-outline" @onclick="ClearFilters">Đặt lại</button>
                    </div>

                    @if (FilteredStudents.Count == 0)
                    {
                        <div class="empty-state">
                            <div>⌕</div>
                            <b>Không tìm thấy học viên</b>
                            <p>Thử thay đổi từ khóa hoặc điều kiện lọc.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>HỌ VÀ TÊN</th>
                                        <th>NGÀY SINH</th>
                                        <th>LỚP</th>
                                        <th>ĐIỂM</th>
                                        <th>XẾP LOẠI</th>
                                        <th>THAO TÁC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < FilteredStudents.Count; i++)
                                    {
                                        var hv = FilteredStudents[i];
                                        <tr>
                                            <td class="muted-cell">@(i + 1)</td>
                                            <td>
                                                <div class="student-name">
                                                    <div class="student-avatar">@Initials(hv.HoTen)</div>
                                                    <div><b>@hv.HoTen</b><small>@hv.DiaChiHienTai</small></div>
                                                </div>
                                            </td>
                                            <td>@hv.NgaySinh.ToString("dd/MM/yyyy")</td>
                                            <td><span class="class-tag">@hv.Lop</span></td>
                                            <td><b>@hv.DiemRenLuyen.ToString("0.0")</b><span class="muted-cell">/10</span></td>
                                            <td><span class="@BadgeClass(hv.XepLoai)">@hv.XepLoai</span></td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-button edit-button" title="Chỉnh sửa" @onclick="() => EditStudent(hv)">✎</button>
                                                    <button class="icon-button delete-button" title="Xóa" @onclick="() => DeleteStudent(hv.Id)">⌫</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
                <p class="footnote">Lưu ý: Dữ liệu hiện được lưu trong bộ nhớ của ứng dụng, chưa lưu vào cơ sở dữ liệu.</p>
            }

            <footer class="page-footer">
                <span>QUẢN LÝ RÈN LUYỆN HỌC VIÊN</span>
                <span>Hệ thống quản lý nội bộ · Phiên bản 1.0</span>
            </footer>
        </main>
    </div>
</div>

<style>
    :root {
        --green: #16834b;
        --green-dark: #10673b;
        --green-light: #e9f6ee;
        --text: #1e3027;
        --muted: #7d8b83;
        --border: #e7ede8;
        --background: #f5f8f5;
    }

    .app-page {
        min-height: 100vh;
        background: var(--background);
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 14px;
    }

    .topbar {
        min-height: 78px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        gap: 20px;
    }

    .brand, .topbar-right, .student-name, .action-buttons {
        display: flex;
        align-items: center;
    }

    .brand {
        gap: 13px;
    }

    .brand-logo {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        border-radius: 13px;
        background: var(--green);
        color: white;
        font-size: 18px;
        font-weight: 800;
    }

    .brand h2 {
        font-size: 15px;
        letter-spacing: .5px;
        margin: 0 0 5px;
    }

    .brand span {
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 1.3px;
    }

    .topbar-right {
        gap: 22px;
    }

    .system-status {
        color: #5e7567;
        font-size: 12px;
    }

        .system-status span {
            display: inline-block;
            width: 7px;
            height: 7px;
            background: #21a564;
            border-radius: 50%;
            margin-right: 5px;
        }

    .user-avatar, .student-avatar {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--green-light);
        color: var(--green);
        font-weight: 700;
    }

    .page-layout {
        display: flex;
        min-height: calc(100vh - 78px);
    }

    .sidebar {
        width: 245px;
        flex-shrink: 0;
        background: white;
        border-right: 1px solid var(--border);
        padding: 27px 16px 18px;
        display: flex;
        flex-direction: column;
    }

    .side-caption {
        color: #9aa79e;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.1px;
        padding: 0 12px;
        margin-bottom: 12px;
    }

    .side-caption-second {
        margin-top: 28px;
    }

    .nav-item {
        border: 0;
        border-radius: 10px;
        padding: 12px 13px;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        background: transparent;
        color: #607168;
        text-align: left;
        cursor: pointer;
        margin: 3px 0;
        font-size: 13px;
        transition: .2s;
    }

        .nav-item span {
            width: 18px;
            text-align: center;
            font-size: 17px;
        }

        .nav-item:hover {
            background: #f0f7f2;
            color: var(--green);
        }

        .nav-item.active {
            background: var(--green-light);
            color: var(--green-dark);
            font-weight: 700;
        }

    .sidebar-note {
        margin-top: auto;
        background: #f1f8f3;
        border: 1px solid #e2efe5;
        border-radius: 14px;
        padding: 16px;
        line-height: 1.6;
    }

    .note-icon {
        color: var(--green);
        font-size: 22px;
        margin-bottom: 9px;
    }

    .sidebar-note b {
        font-size: 12px;
    }

    .sidebar-note p {
        font-size: 11px;
        color: #728278;
        margin: 7px 0 0;
    }

    .sidebar-footer {
        color: #a2ada5;
        font-size: 10px;
        letter-spacing: 1px;
        padding: 23px 10px 0;
    }

    .main-content {
        min-width: 0;
        flex: 1;
        padding: 26px 32px;
    }

    .breadcrumb {
        font-size: 12px;
        color: #87958b;
        margin-bottom: 23px;
    }

        .breadcrumb span {
            padding: 0 9px;
            color: #bdc8c0;
        }

    .welcome-banner {
        min-height: 220px;
        background: linear-gradient(115deg, #126e40, #219657);
        border-radius: 19px;
        color: white;
        padding: 31px 35px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
        position: relative;
    }

    .eyebrow {
        font-size: 10px;
        letter-spacing: 1.4px;
        font-weight: 700;
    }

    .welcome-banner h1 {
        font-size: clamp(23px, 2.4vw, 31px);
        margin: 13px 0 10px;
    }

    .welcome-banner p {
        color: #e0f1e5;
        font-size: 13px;
        line-height: 1.7;
        max-width: 540px;
    }

    .banner-symbol {
        width: 150px;
        height: 150px;
        flex-shrink: 0;
        margin: 0 30px;
        border: 1px solid #ffffff40;
        background: #ffffff12;
        color: #ffffffbd;
        border-radius: 42px;
        transform: rotate(-8deg);
        display: grid;
        place-items: center;
        font-size: 83px;
        font-weight: 300;
    }

    button {
        font-family: inherit;
    }

    .btn-primary, .btn-secondary, .btn-outline, .btn-close, .icon-button {
        border-radius: 9px;
        cursor: pointer;
        transition: background .18s, transform .18s;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-primary {
        padding: 11px 16px;
        background: var(--green);
        color: white;
        border: 1px solid var(--green);
    }

    .welcome-banner .btn-primary {
        background: white;
        color: var(--green-dark);
        border-color: white;
        margin-top: 9px;
    }

    .btn-primary:hover {
        background: var(--green-dark);
        color: white;
    }

    .welcome-banner .btn-primary:hover {
        background: #eaf6ee;
        color: var(--green-dark);
    }

    .btn-secondary {
        padding: 11px 17px;
        background: white;
        color: #5d6d63;
        border: 1px solid #dce5de;
    }

    .btn-outline {
        padding: 10px 14px;
        background: white;
        color: var(--green);
        border: 1px solid #cfe3d5;
    }

        .btn-outline:hover, .btn-secondary:hover {
            background: var(--green-light);
        }

    .btn-close {
        background: #f4f7f4;
        border: 0;
        width: 32px;
        height: 32px;
        color: #728078;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 28px 0 17px;
    }

        .section-heading h2, .section-heading h1 {
            font-size: 19px;
            margin: 0 0 7px;
        }

        .section-heading p, .panel-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

    .live-tag {
        font-size: 9px;
        letter-spacing: .5px;
        color: var(--green);
        background: var(--green-light);
        padding: 8px 10px;
        border-radius: 7px;
        white-space: nowrap;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
    }

    .stat-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 19px;
        min-width: 0;
    }

    .stat-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 18px;
        margin-bottom: 15px;
    }

    .green-icon {
        color: #16834b;
