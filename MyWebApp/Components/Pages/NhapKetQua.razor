@page "/nhap-ket-qua"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MyWebApp.Models
@inject MyWebApp.Data.AppDbContext DbContext

<PageTitle>Nhập kết quả rèn luyện</PageTitle>

<div class="app-page">
    <header class="topbar">
        <div class="brand">
            <img class="brand-logo-image" src="images/Logo_Bộ_Công_an_VN.png" alt="Biểu trưng Công an nhân dân" />
            <div class="brand-divider"></div>
            <img class="brand-logo-image academy-logo" src="images/Logo_hoc_vien_ANND.png" alt="Logo Học viện An ninh nhân dân" />
            <div class="brand-text"><h2>HỌC VIỆN AN NINH NHÂN DÂN</h2><small>HỆ THỐNG QUẢN LÝ RÈN LUYỆN HỌC VIÊN</small></div>
        </div>
        <div class="topbar-right"><span class="system-status"><span></span> HỆ THỐNG QUẢN LÝ</span><div class="user-avatar">HV</div></div>
    </header>

    <div class="page-layout">
        <aside class="sidebar">
            <div class="side-caption">MENU CHÍNH</div>
            <a class="nav-item" href="/dshocvien"><span>⌂</span> Trang chủ / Học viên</a>
            <div class="side-caption side-caption-second">QUẢN LÝ RÈN LUYỆN</div>
            <a class="nav-item" href="/ky-danh-gia"><span>▣</span> Kỳ đánh giá</a>
            <a class="nav-item" href="/quan-ly-tieu-chi"><span>✓</span> Tiêu chí đánh giá</a>
            <a class="nav-item active" href="/nhap-ket-qua"><span>✎</span> Nhập kết quả</a>
            <a class="nav-item" href="/bao-cao-ket-qua"><span>▤</span> Báo cáo kết quả</a>
            <div class="sidebar-note"><div class="note-icon">✦</div><b>Nhập kết quả rèn luyện</b><p>Chấm điểm từng tiêu chí cho học viên theo kỳ đánh giá.</p></div>
            <div class="sidebar-footer">HỌC VIỆN AN NINH NHÂN DÂN</div>
        </aside>

        <main class="main-content">
            <div class="breadcrumb">Trang chủ <span>/</span> Quản lý rèn luyện <span>/</span> Nhập kết quả</div>
            <div class="section-heading page-title-row">
                <div><span class="eyebrow green-text">QUẢN LÝ RÈN LUYỆN</span><h1>Nhập kết quả rèn luyện</h1><p>Chọn kỳ đánh giá, lớp và học viên để nhập điểm theo từng tiêu chí.</p></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(thongBao))
            {
                <div class="notice-box @loaiThongBao"><span>@thongBao</span><button type="button" class="notice-close" @onclick="() => thongBao = string.Empty">×</button></div>
            }

            <section class="panel">
                <div class="panel-heading"><div><h2>Thông tin đánh giá</h2><p>Chỉ các kỳ đang mở và tiêu chí đang sử dụng được dùng để nhập điểm.</p></div></div>
                <div class="form-grid">
                    <div class="form-field">
                        <label>Kỳ đánh giá</label>
                        <select class="form-control-custom" @bind="kyId" @bind:after="TaiDuLieuNhap">
                            <option value="0">-- Chọn kỳ đánh giá --</option>
                            @foreach (var ky in cacKy.Where(x => !x.DaKhoa))
                            {
                                <option value="@ky.Id">@ky.TenKy</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Lớp học viên</label>
                        <select class="form-control-custom" @bind="lopChon" @bind:after="TaiDanhSachHocVien">
                            <option value="">-- Chọn lớp --</option>
                            @foreach (var lop in cacLop)
                            {
                                <option value="@lop">@lop</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Học viên</label>
                        <select class="form-control-custom" @bind="hocVienId" @bind:after="TaiDuLieuNhap">
                            <option value="0">-- Chọn học viên --</option>
                            @foreach (var hv in hocViens)
                            {
                                <option value="@hv.Id">@hv.HoTen</option>
                            }
                        </select>
                    </div>
                </div>
            </section>

            @if (kyId > 0 && hocVienId > 0)
            {
                <section class="panel">
                    <div class="panel-heading"><div><h2>Bảng chấm điểm tiêu chí</h2><p>Nhập điểm đạt, không vượt quá điểm tối đa của từng tiêu chí.</p></div><span class="live-tag">THANG ĐIỂM TIÊU CHÍ</span></div>
                    @if (tieuChis.Count == 0)
                    {
                        <div class="empty-state"><b>Chưa có tiêu chí đang sử dụng</b><p>Hãy kiểm tra trang Quản lý tiêu chí đánh giá.</p></div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>STT</th><th>TÊN TIÊU CHÍ</th><th>ĐIỂM TỐI ĐA</th><th>ĐIỂM ĐẠT</th></tr></thead>
                                <tbody>
                                    @foreach (var tc in tieuChis)
                                    {
                                        <tr><td>@tc.ThuTu</td><td><b>@tc.TenTieuChi</b><div class="muted-cell">@tc.MoTa</div></td><td><b>@tc.DiemToiDa</b></td><td><input class="score-input" type="number" min="0" max="@tc.DiemToiDa" step="0.5" @bind="diemNhap[tc.Id]" /></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="score-summary"><span>Tổng điểm đạt</span><strong>@TongDiem.ToString("0.##") / @TongDiemToiDa.ToString("0.##")</strong><span>Điểm quy đổi: <b>@DiemQuyDoi.ToString("0.0") / 10</b></span><span>Xếp loại: <b>@XepLoai(DiemQuyDoi)</b></span></div>
                        <div class="form-actions"><button type="button" class="btn-primary" @onclick="LuuKetQua">✓ Lưu kết quả</button></div>
                    }
                </section>
            }
            else
            {
                <section class="panel empty-state"><div>▤</div><b>Chưa chọn đủ thông tin</b><p>Hãy chọn kỳ đánh giá, lớp và học viên để bắt đầu nhập điểm.</p></section>
            }
            <footer class="page-footer"><span>QUẢN LÝ RÈN LUYỆN HỌC VIÊN</span><span>Hệ thống quản lý nội bộ · Phiên bản 1.0</span></footer>
        </main>
    </div>
</div>

<style>
