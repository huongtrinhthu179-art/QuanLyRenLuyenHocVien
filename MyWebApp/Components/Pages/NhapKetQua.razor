</style>

@code {
    private List<KyDanhGia> cacKy = new();
    private List<string> cacLop = new();
    private List<HocVien> hocViens = new();
    private List<TieuChiDanhGia> tieuChis = new();
    private Dictionary<int, double> diemNhap = new();
    private int kyId;
    private int hocVienId;
    private string lopChon = "";
    private string thongBao = "";
    private string loaiThongBao = "alert-success";
    private double TongDiem => diemNhap.Values.Sum();
    private double TongDiemToiDa => tieuChis.Sum(x => x.DiemToiDa);
    private double DiemQuyDoi => TongDiemToiDa <= 0 ? 0 : TongDiem / TongDiemToiDa * 10.0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cacKy = await DbContext.KyDanhGias.AsNoTracking().OrderByDescending(x => x.Id).ToListAsync();
            cacLop = await DbContext.HocViens.AsNoTracking()
                .Where(x => x.Lop != null).Select(x => x.Lop).Distinct().OrderBy(x => x).ToListAsync();
            tieuChis = await DbContext.TieuChiDanhGias.AsNoTracking()
                .Where(x => x.DangSuDung).OrderBy(x => x.ThuTu).ToListAsync();
            diemNhap = tieuChis.ToDictionary(x => x.Id, x => 0.0);
        }
        catch (Exception ex)
        {
            ThongBao("Lỗi tải dữ liệu: " + ex.GetBaseException().Message, "alert-danger");
        }
    }

    private async Task TaiDanhSachHocVien()
    {
        try
        {
            hocVienId = 0;
            hocViens = string.IsNullOrWhiteSpace(lopChon)
                ? new()
                : await DbContext.HocViens.AsNoTracking().Where(x => x.Lop == lopChon).OrderBy(x => x.HoTen).ToListAsync();
            diemNhap = tieuChis.ToDictionary(x => x.Id, x => 0.0);
        }
        catch (Exception ex)
        {
            ThongBao("Lỗi tải danh sách học viên: " + ex.GetBaseException().Message, "alert-danger");
        }
    }

    private async Task TaiDuLieuNhap()
    {
        diemNhap = tieuChis.ToDictionary(x => x.Id, x => 0.0);
        if (kyId <= 0 || hocVienId <= 0) return;
        try
        {
            var daLuu = await DbContext.Set<KetQuaTieuChi>().AsNoTracking()
                .Where(x => x.KyDanhGiaId == kyId && x.HocVienId == hocVienId).ToListAsync();
            foreach (var item in daLuu)
                if (diemNhap.ContainsKey(item.TieuChiDanhGiaId)) diemNhap[item.TieuChiDanhGiaId] = item.DiemDat;
        }
        catch (Exception ex)
        {
            ThongBao("Lỗi tải điểm đã lưu: " + ex.GetBaseException().Message, "alert-danger");
        }
    }

    private async Task LuuKetQua()
    {
        try
        {
            if (kyId <= 0 || hocVienId <= 0) { ThongBao("Hãy chọn kỳ đánh giá và học viên.", "alert-danger"); return; }
            var ky = await DbContext.KyDanhGias.FirstOrDefaultAsync(x => x.Id == kyId);
            if (ky == null || ky.DaKhoa) { ThongBao("Kỳ đánh giá không tồn tại hoặc đã khóa.", "alert-danger"); return; }
            if (tieuChis.Count == 0) { ThongBao("Chưa có tiêu chí đang sử dụng.", "alert-danger"); return; }
            foreach (var tc in tieuChis)
            {
                var diem = diemNhap.GetValueOrDefault(tc.Id);
                if (diem < 0 || diem > tc.DiemToiDa) { ThongBao($"Điểm tiêu chí '{tc.TenTieuChi}' phải từ 0 đến {tc.DiemToiDa}.", "alert-danger"); return; }
            }
            var daCo = await DbContext.Set<KetQuaTieuChi>().Where(x => x.KyDanhGiaId == kyId && x.HocVienId == hocVienId).ToListAsync();
            DbContext.Set<KetQuaTieuChi>().RemoveRange(daCo);
            foreach (var tc in tieuChis)
                DbContext.Set<KetQuaTieuChi>().Add(new KetQuaTieuChi { HocVienId = hocVienId, KyDanhGiaId = kyId, TieuChiDanhGiaId = tc.Id, DiemDat = diemNhap.GetValueOrDefault(tc.Id), DiemToiDa = tc.DiemToiDa });
            await DbContext.SaveChangesAsync();
            ThongBao($"Đã lưu kết quả. Tổng {TongDiem:0.##}/{TongDiemToiDa:0.##}, quy đổi {DiemQuyDoi:0.0}/10 – {XepLoai(DiemQuyDoi)}.", "alert-success");
        }
        catch (Exception ex)
        {
            DbContext.ChangeTracker.Clear();
            ThongBao("Lỗi khi lưu: " + ex.GetBaseException().Message, "alert-danger");
        }
    }

    private static string XepLoai(double diem) => diem switch { >= 9 => "Xuất sắc", >= 8 => "Giỏi", >= 7 => "Khá", >= 5 => "Trung bình", _ => "Không xếp loại" };
    private void ThongBao(string noiDung, string loai) { thongBao = noiDung; loaiThongBao = loai; }
}