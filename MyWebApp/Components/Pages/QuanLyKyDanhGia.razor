@code {
    private List<KyDanhGia> cacKyDanhGia = new();

    private KyDanhGia model = TaoModelMoi();

    private bool dangSua = false;
    private int idDangSua = 0;

    private string thongBao = "";
    private string loaiThongBao = "alert-info";

    private static KyDanhGia TaoModelMoi()
    {
        return new KyDanhGia
        {
            NgayBatDau = DateTime.Today,
            NgayKetThuc = DateTime.Today
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSach();
    }

    private async Task TaiDanhSach()
    {
        cacKyDanhGia = await DbContext.KyDanhGias
            .AsNoTracking()
            .OrderByDescending(x => x.Id)
            .ToListAsync();
    }

    private async Task LuuKyDanhGia()
    {
        if (string.IsNullOrWhiteSpace(model.TenKy))
        {
            HienThongBao("Vui lòng nhập tên kỳ đánh giá.", "alert-danger");
            return;
        }

        if (model.NgayKetThuc.Date < model.NgayBatDau.Date)
        {
            HienThongBao(
                "Ngày kết thúc không được trước ngày bắt đầu.",
                "alert-danger");
            return;
        }

        if (!dangSua)
        {
            var kyMoi = new KyDanhGia
            {
                TenKy = model.TenKy.Trim(),
                NgayBatDau = model.NgayBatDau,
                NgayKetThuc = model.NgayKetThuc,
                DaKhoa = false
            };

            DbContext.KyDanhGias.Add(kyMoi);
        }
        else
        {
            var kyCanSua = await DbContext.KyDanhGias
                .FirstOrDefaultAsync(x => x.Id == idDangSua);

            if (kyCanSua == null)
            {
                HienThongBao("Không tìm thấy kỳ đánh giá cần sửa.", "alert-danger");
                return;
            }

            if (kyCanSua.DaKhoa)
            {
                HienThongBao("Kỳ đánh giá đã khóa nên không thể sửa.", "alert-danger");
                return;
            }

            kyCanSua.TenKy = model.TenKy.Trim();
            kyCanSua.NgayBatDau = model.NgayBatDau;
            kyCanSua.NgayKetThuc = model.NgayKetThuc;
        }

        await DbContext.SaveChangesAsync();
        await TaiDanhSach();

        model = TaoModelMoi();
        dangSua = false;
        idDangSua = 0;

        HienThongBao("Lưu kỳ đánh giá thành công!", "alert-success");
    }

    private void SuaKyDanhGia(KyDanhGia ky)
    {
        if (ky.DaKhoa)
        {
            HienThongBao("Kỳ đã khóa, hãy mở lại trước khi sửa.", "alert-warning");
            return;
        }

        model = new KyDanhGia
        {
            TenKy = ky.TenKy,
            NgayBatDau = ky.NgayBatDau,
            NgayKetThuc = ky.NgayKetThuc
        };

        idDangSua = ky.Id;
        dangSua = true;
        thongBao = "";
    }

    private async Task DoiTrangThai(KyDanhGia ky)
    {
        var kyTrongDb = await DbContext.KyDanhGias
            .FirstOrDefaultAsync(x => x.Id == ky.Id);

        if (kyTrongDb == null)
            return;

        kyTrongDb.DaKhoa = !kyTrongDb.DaKhoa;

        await DbContext.SaveChangesAsync();
        await TaiDanhSach();

        if (dangSua && idDangSua == ky.Id)
        {
            model = TaoModelMoi();
            dangSua = false;
            idDangSua = 0;
        }

        HienThongBao(
            kyTrongDb.DaKhoa
                ? "Đã khóa kỳ đánh giá."
                : "Đã mở lại kỳ đánh giá.",
            "alert-success");
    }

    private void HuySua()
    {
        model = TaoModelMoi();
        dangSua = false;
        idDangSua = 0;
        thongBao = "";
    }

    private void HienThongBao(string noiDung, string loai)
    {
        thongBao = noiDung;
        loaiThongBao = loai;
    }
}
