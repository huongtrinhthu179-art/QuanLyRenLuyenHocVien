@code {

    private List<TieuChiDanhGia> danhSach = new();

    private TieuChiDanhGia model = TaoModelMoi();

    private bool dangSua = false;

    private int idDangSua = 0;

    private string thongBao = "";

    private string loaiThongBao = "alert-info";
    private void XoaThongBao()
    {
        thongBao = string.Empty;
    }

    private static TieuChiDanhGia TaoModelMoi()
    {
        return new TieuChiDanhGia
        {
            TenTieuChi = "",
            MoTa = "",
            DiemToiDa = 10,
            ThuTu = 1,
            DangSuDung = true
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSach();

        if (danhSach.Count == 0)
        {
            await TaoDuLieuMacDinh();
        }
    }

    private async Task TaiDanhSach()
    {
        danhSach = await DbContext.TieuChiDanhGias
            .AsNoTracking()
            .OrderBy(x => x.ThuTu)
            .ThenBy(x => x.Id)
            .ToListAsync();
    }

    private async Task TaoDuLieuMacDinh()
    {
        var macDinh = new List<TieuChiDanhGia>
        {
            new()
            {
                TenTieuChi = "Ý thức tổ chức kỷ luật",
                MoTa = "Chấp hành nội quy, quy định và điều lệnh.",
                DiemToiDa = 25,
                ThuTu = 1
            },
            new()
            {
                TenTieuChi = "Kết quả học tập",
                MoTa = "Kết quả học tập và ý thức học tập.",
                DiemToiDa = 25,
                ThuTu = 2
            },
            new()
            {
                TenTieuChi = "Phẩm chất đạo đức",
                MoTa = "Phẩm chất đạo đức và lối sống.",
                DiemToiDa = 20,
                ThuTu = 3
            },
            new()
            {
                TenTieuChi = "Tham gia hoạt động",
                MoTa = "Tham gia các hoạt động tập thể.",
                DiemToiDa = 15,
                ThuTu = 4
            },
            new()
            {
                TenTieuChi = "Tinh thần trách nhiệm",
                MoTa = "Tinh thần trách nhiệm trong học tập và sinh hoạt.",
                DiemToiDa = 15,
                ThuTu = 5
            }
        };

        DbContext.TieuChiDanhGias.AddRange(macDinh);

        await DbContext.SaveChangesAsync();

        await TaiDanhSach();
    }

    private async Task LuuTieuChi()
    {
        if (string.IsNullOrWhiteSpace(model.TenTieuChi))
        {
            HienThongBao("Vui lòng nhập tên tiêu chí.", "alert-danger");
            return;
        }

        if (model.DiemToiDa <= 0 || model.DiemToiDa > 100)
        {
            HienThongBao("Điểm tối đa phải lớn hơn 0 và không quá 100.", "alert-danger");
            return;
        }

        if (model.ThuTu <= 0)
        {
            HienThongBao("Thứ tự phải lớn hơn 0.", "alert-danger");
            return;
        }

        var tenTrung = danhSach.Any(x =>
            x.Id != idDangSua &&
            x.TenTieuChi.Trim().Equals(
                model.TenTieuChi.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (tenTrung)
        {
            HienThongBao("Tên tiêu chí đã tồn tại.", "alert-danger");
            return;
        }

        double tongDiem = danhSach
            .Where(x => x.DangSuDung && (!dangSua || x.Id != idDangSua))
            .Sum(x => x.DiemToiDa);

        if (model.DangSuDung && tongDiem + model.DiemToiDa > 100)
        {
            HienThongBao(
                $"Tổng điểm tối đa không được vượt quá 100. Hiện còn {100 - tongDiem} điểm.",
                "alert-danger");
            return;
        }

        if (!dangSua)
        {
            var moi = new TieuChiDanhGia
            {
                TenTieuChi = model.TenTieuChi.Trim(),
                MoTa = model.MoTa.Trim(),
                DiemToiDa = model.DiemToiDa,
                ThuTu = model.ThuTu,
                DangSuDung = true
            };

            DbContext.TieuChiDanhGias.Add(moi);
        }
        else
        {
            var canSua = await DbContext.TieuChiDanhGias
                .FirstOrDefaultAsync(x => x.Id == idDangSua);

            if (canSua == null)
            {
                HienThongBao("Không tìm thấy tiêu chí cần sửa.", "alert-danger");
                return;
            }

            canSua.TenTieuChi = model.TenTieuChi.Trim();
            canSua.MoTa = model.MoTa.Trim();
            canSua.DiemToiDa = model.DiemToiDa;
            canSua.ThuTu = model.ThuTu;
        }

        await DbContext.SaveChangesAsync();

        await TaiDanhSach();

        model = TaoModelMoi();
        dangSua = false;
        idDangSua = 0;

        HienThongBao("Lưu tiêu chí thành công!", "alert-success");
    }

    private void SuaTieuChi(TieuChiDanhGia tc)
    {
        model = new TieuChiDanhGia
        {
            TenTieuChi = tc.TenTieuChi,
            MoTa = tc.MoTa,
            DiemToiDa = tc.DiemToiDa,
            ThuTu = tc.ThuTu,
            DangSuDung = tc.DangSuDung
        };

        idDangSua = tc.Id;
        dangSua = true;
        thongBao = "";
    }

    private async Task DoiTrangThai(TieuChiDanhGia tc)
    {
        var canSua = await DbContext.TieuChiDanhGias
            .FirstOrDefaultAsync(x => x.Id == tc.Id);

        if (canSua == null)
            return;

        if (canSua.DangSuDung)
        {
            canSua.DangSuDung = false;
        }
        else
        {
            double tongDiem = danhSach
                .Where(x => x.DangSuDung && x.Id != tc.Id)
                .Sum(x => x.DiemToiDa);

            if (tongDiem + canSua.DiemToiDa > 100)
            {
                HienThongBao("Tổng điểm đang sử dụng sẽ vượt quá 100.", "alert-danger");
                return;
            }

            canSua.DangSuDung = true;
        }

        await DbContext.SaveChangesAsync();

        await TaiDanhSach();

        HienThongBao("Đã thay đổi trạng thái tiêu chí.", "alert-success");
    }

    private async Task XoaTieuChi(TieuChiDanhGia tc)
    {
        bool xacNhan = await JS.InvokeAsync<bool>(
            "confirm",
            $"Bạn có chắc chắn muốn xóa tiêu chí '{tc.TenTieuChi}' không?");

        if (!xacNhan)
            return;

        var canXoa = await DbContext.TieuChiDanhGias
            .FirstOrDefaultAsync(x => x.Id == tc.Id);

        if (canXoa == null)
            return;

        DbContext.TieuChiDanhGias.Remove(canXoa);

        await DbContext.SaveChangesAsync();

        await TaiDanhSach();

        if (dangSua && idDangSua == tc.Id)
        {
            HuySua();
        }

        HienThongBao("Đã xóa tiêu chí thành công.", "alert-success");
    }

    private void HuySua()
    {
        model = TaoModelMoi();
        dangSua = false;
        idDangSua = 0;
        thongBao = "";
    }

    private void HienThongBao(string noiDung, string loai)
    {
        thongBao = noiDung;
        loaiThongBao = loai;
    }
}