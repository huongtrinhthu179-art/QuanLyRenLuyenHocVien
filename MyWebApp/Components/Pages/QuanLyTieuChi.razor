@page "/quan-ly-tieu-chi"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MyWebApp.Models
@inject MyWebApp.Data.AppDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Quản lý tiêu chí đánh giá</PageTitle>

<div class="app-page criteria-page">
    <header class="topbar">
        <div class="brand">
            <img class="brand-logo-image" src="images/Logo_Bộ_Công_an_VN.png" alt="Biểu trưng Công an nhân dân" />
            <div class="brand-divider"></div>
            <img class="brand-logo-image academy-logo" src="images/Logo_hoc_vien_ANND.png" alt="Logo Học viện An ninh nhân dân" />
            <div class="brand-text">
                <h2>HỌC VIỆN AN NINH NHÂN DÂN</h2>
                <small>HỆ THỐNG QUẢN LÝ RÈN LUYỆN HỌC VIÊN</small>
            </div>
        </div>
        <div class="topbar-right">
            <span class="system-status"><span></span> HỆ THỐNG QUẢN LÝ</span>
            <div class="user-avatar">HV</div>
        </div>
    </header>

    <div class="page-layout">
        <aside class="sidebar">
            <div class="side-caption">MENU CHÍNH</div>
            <a class="nav-item" href="/dshocvien"><span>⌂</span> Trang chủ / Học viên</a>

            <div class="side-caption side-caption-second">QUẢN LÝ RÈN LUYỆN</div>
            <a class="nav-item" href="/ky-danh-gia"><span>▣</span> Kỳ đánh giá</a>
            <a class="nav-item active" href="/quan-ly-tieu-chi"><span>✓</span> Tiêu chí đánh giá</a>
            <a class="nav-item" href="/bao-cao-ket-qua"><span>▤</span> Báo cáo kết quả</a>

            <div class="sidebar-note">
                <div class="note-icon">✦</div>
                <b>Quản lý tiêu chí</b>
                <p>Thiết lập nội dung và điểm tối đa cho từng tiêu chí rèn luyện học viên.</p>
            </div>
            <div class="sidebar-footer">HỌC VIỆN AN NINH NHÂN DÂN</div>
        </aside>

        <main class="main-content">
            <div class="breadcrumb">Trang chủ <span>/</span> Quản lý rèn luyện <span>/</span> Tiêu chí đánh giá</div>

            <div class="section-heading page-title-row">
                <div>
                    <span class="eyebrow green-text">QUẢN LÝ RÈN LUYỆN</span>
                    <h1>Quản lý tiêu chí đánh giá</h1>
                    <p>Thiết lập và quản lý các tiêu chí, điểm tối đa trong đánh giá rèn luyện học viên.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(thongBao))
            {
                <div class="notice-box @loaiThongBao">
                    <span>@thongBao</span>
                    <button type="button" class="notice-close" @onclick="XoaThongBao">×</button>
                </div>
            }

            <div class="stats-grid criteria-stats">
                <div class="stat-card">
                    <div class="stat-icon green-icon">▤</div>
                    <div class="stat-label">Tổng số tiêu chí</div>
                    <div class="stat-number">@danhSach.Count</div>
                    <div class="stat-foot">Tiêu chí đã được thiết lập</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue-icon">◎</div>
                    <div class="stat-label">Tổng điểm tối đa đang sử dụng</div>
                    <div class="stat-number">@danhSach.Where(x => x.DangSuDung).Sum(x => x.DiemToiDa)<small> / 100</small></div>
                    <div class="stat-foot">Thang điểm tiêu chí đánh giá</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon gold-icon">✓</div>
                    <div class="stat-label">Tiêu chí đang sử dụng</div>
                    <div class="stat-number">@danhSach.Count(x => x.DangSuDung)</div>
                    <div class="stat-foot">Tiêu chí có hiệu lực</div>
                </div>
            </div>

            <section class="panel form-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow green-text">THIẾT LẬP DANH MỤC</span>
                        <h2>@(dangSua ? "Cập nhật tiêu chí" : "Thêm tiêu chí mới")</h2>
                        <p>Nhập thông tin tiêu chí và điểm tối đa tương ứng.</p>
                    </div>
                    @if (dangSua)
                    {
                        <button type="button" class="btn-close" title="Hủy chỉnh sửa" @onclick="HuySua">×</button>
                    }
                </div>

                <EditForm Model="@model" OnValidSubmit="LuuTieuChi">
                    <div class="form-grid">
                        <div class="form-field">
                            <label>Tên tiêu chí <span>*</span></label>
                            <InputText class="form-control-custom" @bind-Value="model.TenTieuChi" placeholder="Nhập tên tiêu chí..." />
                        </div>
                        <div class="form-field">
                            <label>Điểm tối đa <span>*</span></label>
                            <InputNumber class="form-control-custom" @bind-Value="model.DiemToiDa" />
                        </div>
                        <div class="form-field">
                            <label>Thứ tự hiển thị</label>
                            <InputNumber class="form-control-custom" @bind-Value="model.ThuTu" />
                        </div>
                        <div class="form-field full-field">
                            <label>Mô tả tiêu chí</label>
                            <InputTextArea class="form-control-custom" @bind-Value="model.MoTa" rows="3" placeholder="Mô tả nội dung đánh giá của tiêu chí..." />
                        </div>
                    </div>
                    <div class="form-actions">
                        @if (dangSua)
                        {
                            <button type="button" class="btn-secondary" @onclick="HuySua">Hủy sửa</button>
                        }
                        <button type="submit" class="btn-primary">@(dangSua ? "✓ Lưu thay đổi" : "＋ Thêm tiêu chí")</button>
                    </div>
                </EditForm>
            </section>

            <section class="panel">
                <div class="panel-heading">
                    <div>
                        <h2>Danh sách tiêu chí đánh giá</h2>
                        <p>Quản lý thứ tự, điểm tối đa và trạng thái sử dụng của từng tiêu chí.</p>
                    </div>
                    <span class="live-tag">● @danhSach.Count tiêu chí</span>
                </div>

                @if (danhSach.Count == 0)
                {
                    <div class="empty-state">
                        <div>▤</div>
                        <b>Chưa có tiêu chí đánh giá</b>
                        <p>Thêm tiêu chí mới để bắt đầu thiết lập danh mục đánh giá.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>THỨ TỰ</th>
                                    <th>TÊN TIÊU CHÍ</th>
                                    <th>MÔ TẢ</th>
                                    <th>ĐIỂM TỐI ĐA</th>
                                    <th>TRẠNG THÁI</th>
                                    <th>THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tc in danhSach)
                                {
                                    <tr>
                                        <td><span class="order-tag">@tc.ThuTu</span></td>
                                        <td><b class="criterion-name">@tc.TenTieuChi</b></td>
                                        <td class="description-cell">@tc.MoTa</td>
                                        <td><b class="score-value">@tc.DiemToiDa</b><span class="muted-cell"> điểm</span></td>
                                        <td>
                                            @if (tc.DangSuDung)
                                            {
                                                <span class="status-badge status-active">Đang sử dụng</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">Ngừng sử dụng</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <button type="button" class="icon-button edit-button" title="Chỉnh sửa" @onclick="() => SuaTieuChi(tc)">✎</button>
                                                <button type="button" class="state-button" @onclick="() => DoiTrangThai(tc)">@(tc.DangSuDung ? "Ngừng" : "Sử dụng")</button>
                                                <button type="button" class="icon-button delete-button" title="Xóa" @onclick="() => XoaTieuChi(tc)">⌫</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <footer class="page-footer">
                <span>QUẢN LÝ RÈN LUYỆN HỌC VIÊN</span>
                <span>Hệ thống quản lý nội bộ · Phiên bản 1.0</span>
            </footer>
        </main>
    </div>
</div>

<style>
    :root {
        --green: #16834b;
        --green-dark: #10673b;
        --green-light: #e9f6ee;
        --text: #1e3027;
        --muted: #7d8b83;
        --border: #e7ede8;
        --background: #f5f8f5;
    }

    .criteria-page {
        min-height: 100vh;
        background: var(--background);
        color: var(--text);
        font-family: "Segoe UI",Arial,sans-serif;
        font-size: 14px;
    }

        .criteria-page * {
            box-sizing: border-box;
        }

    .topbar {
        min-height: 78px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        gap: 20px;
    }

    .brand, .topbar-right {
        display: flex;
        align-items: center;
    }

    .brand {
        gap: 13px;
        min-width: 0;
    }

    .brand-logo-image {
        width: 45px;
        height: 45px;
        object-fit: contain;
    }

    .academy-logo {
        width: 48px;
    }

    .brand-divider {
        height: 42px;
        width: 1px;
        background: var(--border);
    }

    .brand-text h2 {
        font-size: 15px;
        letter-spacing: .5px;
        margin: 0 0 5px;
        color: #24372b;
    }

    .brand-text small {
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 1.1px;
    }

    .topbar-right {
        gap: 22px;
    }

    .system-status {
        color: #5e7567;
        font-size: 12px;
        white-space: nowrap;
    }

        .system-status span {
            display: inline-block;
            width: 7px;
            height: 7px;
            background: #21a564;
            border-radius: 50%;
            margin-right: 5px;
        }

    .user-avatar {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--green-light);
        color: var(--green);
        font-weight: 700;
    }

    .page-layout {
        display: flex;
        min-height: calc(100vh - 78px);
    }

    .sidebar {
        width: 245px;
        flex-shrink: 0;
        background: white;
        border-right: 1px solid var(--border);
        padding: 27px 16px 18px;
        display: flex;
        flex-direction: column;
    }

    .side-caption {
        color: #9aa79e;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.1px;
        padding: 0 12px;
        margin-bottom: 12px;
    }

    .side-caption-second {
        margin-top: 28px;
    }

    .nav-item {
        text-decoration: none;
        border: 0;
        border-radius: 10px;
        padding: 12px 13px;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        background: transparent;
        color: #607168;
        margin: 3px 0;
        font-size: 13px;
        transition: .2s;
    }

        .nav-item span {
            width: 18px;
            text-align: center;
            font-size: 17px;
        }

        .nav-item:hover {
            background: #f0f7f2;
            color: var(--green);
        }

        .nav-item.active {
            background: var(--green-light);
            color: var(--green-dark);
            font-weight: 700;
        }

    .sidebar-note {
        margin-top: auto;
        background: #f1f8f3;
        border: 1px solid #e2efe5;
        border-radius: 14px;
        padding: 16px;
        line-height: 1.6;
    }

    .note-icon {
        color: var(--green);
        font-size: 22px;
        margin-bottom: 9px;
    }

    .sidebar-note b {
        font-size: 12px;
    }

    .sidebar-note p {
        font-size: 11px;
        color: #728278;
        margin: 7px 0 0;
    }

    .sidebar-footer {
        color: #a2ada5;
        font-size: 10px;
        letter-spacing: 1px;
        padding: 23px 10px 0;
    }

    .main-content {
        min-width: 0;
        flex: 1;
        padding: 26px 32px;
    }

    .breadcrumb {
        font-size: 12px;
        color: #87958b;
        margin-bottom: 23px;
    }

        .breadcrumb span {
            padding: 0 9px;
            color: #bdc8c0;
        }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 3px 0 20px;
    }

        .section-heading h1 {
            font-size: 25px;
            margin: 7px 0;
            color: #24372b;
        }

        .section-heading p, .panel-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

    .eyebrow {
        font-size: 10px;
        letter-spacing: 1.4px;
        font-weight: 700;
    }

    .green-text {
        color: var(--green) !important;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 15px;
    }

    .stat-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 19px;
        min-width: 0;
    }

    .stat-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 18px;
        margin-bottom: 15px;
    }

    .green-icon {
        color: #16834b;
        background: #e9f6ee;
    }

    .blue-icon {
        color: #3977c6;
        background: #edf4ff;
    }

    .gold-icon {
        color: #c18b20;
        background: #fff6df;
    }

    .stat-label {
        color: #7d8a81;
        font-size: 11px;
    }

    .stat-number {
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -.5px;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }

        .stat-number small {
            color: #8a988e;
            font-size: 13px;
            font-weight: 600;
        }

    .stat-foot {
        color: #a0aaa3;
        font-size: 10px;
    }

    .panel {
        margin-top: 23px;
        background: white;
        border: 1px solid var(--border);
        border-radius: 15px;
        overflow: hidden;
    }

    .panel-heading {
        padding: 21px 23px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .panel-heading h2 {
            font-size: 15px;
            margin: 0 0 7px;
            color: #2b3d31;
        }

    .live-tag {
        font-size: 9px;
        letter-spacing: .5px;
        color: var(--green);
        background: var(--green-light);
        padding: 8px 10px;
        border-radius: 7px;
        white-space: nowrap;
    }

    .form-panel .panel-heading {
        border-bottom: 1px solid #edf1ed;
        margin-bottom: 22px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 18px 20px;
        padding: 0 23px;
    }

    .form-field {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .full-field {
        grid-column: 1/-1;
    }

    .form-field label {
        font-size: 12px;
        font-weight: 650;
        color: #425449;
    }

        .form-field label span {
            color: #d44e4e;
        }

    .form-control-custom {
        width: 100%;
        min-width: 0;
        background: white;
        border: 1px solid #dfe7e0;
        border-radius: 9px;
        padding: 11px 12px;
        color: #33483a;
        outline: none;
        font: inherit;
        font-size: 12px;
    }

        .form-control-custom:focus {
            border-color: #55a979;
            box-shadow: 0 0 0 3px #16834b12;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 23px;
    }

    button {
        font-family: inherit;
    }

    .btn-primary, .btn-secondary, .btn-close, .icon-button, .state-button {
        border-radius: 9px;
        cursor: pointer;
        transition: background .18s,transform .18s;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-primary {
        padding: 11px 16px;
        background: var(--green);
        color: white;
        border: 1px solid var(--green);
    }

        .btn-primary:hover {
            background: var(--green-dark);
        }

    .btn-secondary {
        padding: 11px 17px;
        background: white;
        color: #5d6d63;
        border: 1px solid #dce5de;
    }

        .btn-secondary:hover {
            background: var(--green-light);
        }

    .btn-close {
        background: #f4f7f4;
        border: 0;
        width: 32px;
        height: 32px;
        color: #728078;
        font-size: 18px;
    }

    .notice-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 15px;
        margin-bottom: 18px;
        border-radius: 9px;
        font-size: 12px;
    }

    .alert-success {
        background: #e9f6ee;
        color: #176b3e;
        border: 1px solid #cfe8d7;
    }

    .alert-danger {
        background: #fff0ef;
        color: #a83e37;
        border: 1px solid #f3d2cf;
    }

    .alert-info {
        background: #edf4ff;
        color: #35649d;
        border: 1px solid #d8e6fa;
    }

    .notice-close {
        border: 0;
        background: transparent;
        color: inherit;
        font-size: 20px;
        cursor: pointer;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 850px;
    }

    thead {
        background: #f8faf8;
    }

    th {
        color: #89958c;
        font-size: 9px;
        letter-spacing: .55px;
        font-weight: 700;
        padding: 14px 16px;
        white-space: nowrap;
    }

    td {
        border-top: 1px solid #edf1ed;
        padding: 14px 16px;
        font-size: 12px;
        color: #536258;
        vertical-align: middle;
    }

        td b {
            color: #2b3d31;
        }

    tbody tr:hover {
        background: #fbfdfb;
    }

    .order-tag {
        display: inline-grid;
        place-items: center;
        min-width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #f0f7f2;
        color: var(--green);
        font-weight: 700;
    }

    .criterion-name {
        color: #2b3d31;
    }

    .description-cell {
        min-width: 220px;
        max-width: 360px;
        white-space: normal;
        line-height: 1.5;
    }

    .score-value {
        color: var(--green) !important;
        font-size: 14px;
    }

    .muted-cell {
        color: #9aa79e;
        font-size: 11px;
    }

    .status-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e9f6ee;
        color: #16834b;
    }

    .status-inactive {
        background: #f0f2f1;
        color: #7c8981;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .icon-button {
        width: 31px;
        height: 31px;
        border: 1px solid transparent;
        display: grid;
        place-items: center;
        font-size: 15px;
    }

    .edit-button {
        background: #edf4ff;
        color: #3977c6;
        border-color: #dce9fb;
    }

    .delete-button {
        background: #fff0ef;
        color: #c6534b;
        border-color: #f5d9d6;
    }

    .state-button {
        border: 1px solid #dce8df;
        background: #f5faf6;
        color: #39734e;
        padding: 7px 9px;
    }

        .state-button:hover {
            background: #e9f6ee;
        }

    .empty-state {
        padding: 42px 20px;
        text-align: center;
        color: #718078;
    }

        .empty-state > div {
            font-size: 32px;
            color: #a5cbb0;
            margin-bottom: 12px;
        }

        .empty-state b {
            color: #33483a;
            font-size: 13px;
        }

        .empty-state p {
            font-size: 12px;
            margin: 8px 0 0;
        }

    .page-footer {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        color: #9aa79e;
        font-size: 10px;
        letter-spacing: .4px;
        padding: 25px 2px 5px;
    }

    @@media(max-width:1000px) {
        .sidebar {
            width: 205px;
        }

        .main-content {
            padding: 22px;
        }

        .stats-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media(max-width:700px) {
        .topbar {
            padding: 12px 16px;
        }

        .brand-logo-image {
            width: 35px;
            height: 35px;
        }

        .brand-text h2 {
            font-size: 11px;
        }

        .brand-text small {
            font-size: 8px;
        }

