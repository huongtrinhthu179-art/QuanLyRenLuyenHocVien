@page "/login"
@model MyWebApp.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | Học viện An ninh nhân dân</title>
    <link rel="stylesheet" href="/_content/Radzen.Blazor/css/material-base.css" />
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; font-family: "Segoe UI", Arial, sans-serif; }
        body { color: #123f3d; }
        .login-screen { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; border-top: 4px solid #17110d; }
        .brand-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 24px; background: #fff; text-align: center; }
        .brand-logo { width: 290px; height: 290px; object-fit: contain; margin-bottom: 30px; }
        .brand-title { margin: 0; color: #103c3a; font-size: clamp(25px, 2.2vw, 38px); font-weight: 800; line-height: 1.35; }
        .brand-subtitle { margin: 18px 0 0; color: #84918f; font-size: clamp(17px, 1.5vw, 25px); }
        .form-panel { display: grid; place-items: center; padding: 50px; background: #0a4140; }
        .login-card { width: min(100%, 646px); padding: clamp(32px, 3.2vw, 60px); border-radius: 25px; background: #fff; }
        .login-card h1 { margin: 0 0 42px; color: #123f3d; font-size: clamp(32px, 2.5vw, 44px); font-weight: 500; }
        .form-field { margin-bottom: 26px; }
        .form-field label { display: block; margin-bottom: 12px; color: #234845; font-size: 19px; }
        .login-card .login-control, .login-card .login-control input, .login-card input.login-control { width: 100%; min-height: 70px; border: 1px solid #cad8d6; border-radius: 12px; background: #fff; color: #183d3b; font: inherit; font-size: 18px; }
        .login-form .login-control:focus, .login-form .login-control input:focus { border-color: #247669; outline: 3px solid #24766924; }
        .remember-row { display: flex; align-items: center; gap: 12px; margin: 4px 0 42px; color: #234845; font-size: 18px; }
        .remember-row .rz-chkbox { width: 20px; height: 20px; }
        .login-button { min-height: 74px; border: 0; border-radius: 12px; background: #216d61; color: #fff; font: inherit; font-size: 20px; font-weight: 700; cursor: pointer; }
        .login-button:hover { background: #18594f; }
        .login-card .rz-alert { margin-bottom: 22px; }
        @@media (max-width: 760px) {
            .login-screen { grid-template-columns: 1fr; }
            .brand-panel { padding: 36px 20px 28px; }
            .brand-logo { width: 150px; height: 150px; margin-bottom: 16px; }
            .form-panel { padding: 24px 16px; }
            .login-card { padding: 30px 24px; border-radius: 18px; }
            .login-card h1 { margin-bottom: 28px; }
            .login-card .login-control, .login-card .login-control input, .login-card input.login-control { min-height: 58px; }
            .remember-row { margin-bottom: 28px; }
            .login-button { min-height: 60px; }
        }
    </style>
</head>
<body>
    <component type="typeof(MyWebApp.Pages.Login)"
               render-mode="Static"
               param-ReturnUrl="Model.ReturnUrl"
               param-ErrorMessage="Model.ErrorMessage" />
    <script src="/_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>
